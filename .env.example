# Copy this file to ".env" (same folder) and fill it in. Never share .env: the service-role key is a master key.

# --- Supabase (accounts, wallets, decks, friends). Leave empty to keep accounts in data/meta.json on this PC.
# Supabase dashboard → Project Settings → API
SUPABASE_URL=
# "anon public" key: safe to give to browsers (they use it to sign in)
SUPABASE_ANON_KEY=
# "service_role" key: SECRET, only this server uses it. Keep it out of chats, screenshots and git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server
PORT=8787
# The website's address, so browsers there may call this server. Use * while testing.
ALLOW_ORIGIN=*
